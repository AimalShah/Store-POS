{
  "name": "store-pos",
  "version": "3.0.0",
  "description": "Modern desktop Point of Sale with LAN multi-terminal support",
  "author": "Hosting Domain",
  "private": true,
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "native:node": "node scripts/use-native.mjs node",
    "native:electron": "node scripts/use-native.mjs electron",
    "predev": "npm run native:electron",
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "prestart": "npm run native:electron",
    "start": "electron .",
    "build": "vite build",
    "preview": "vite preview",
    "pretest": "npm run native:node",
    "test": "vitest run",
    "test:watch": "vitest",
    "presmoke": "npm run native:node",
    "smoke": "node scripts/smoke-api.mjs",
    "preqa": "npm run native:node",
    "qa": "cucumber-js --config cucumber.mjs",
    "pree2e": "npm run native:electron",
    "e2e": "playwright test",
    "pree2e:linux": "npm run native:electron",
    "e2e:linux": "xvfb-run -a playwright test",
    "predist": "npm run native:electron",
    "dist": "vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.storepos.app",
    "productName": "Store POS",
    "copyright": "Copyright © Hosting Domain",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "build/icon.ico",
      "public/favicon.ico",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Store POS",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "AimalShah",
        "repo": "Store-POS",
        "releaseType": "release",
        "private": false
      }
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/inter": "^5.3.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "github:WiseLibs/better-sqlite3#v12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cors": "^2.8.5",
    "date-fns": "^4.4.0",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.31.0",
    "multer": "^1.4.5-lts.1",
    "next-themes": "^0.4.6",
    "node-thermal-printer": "^4.6.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^18.3.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.8.0",
    "shadcn": "^4.16.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^43.4.0",
    "electron-builder": "^25.1.8",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.9",
    "wait-on": "^8.0.2"
  }
}
